rules_version = '2';

// Sprout Firestore security rules.
//
// Deny ALL direct client access. Every read/write goes through the Express
// backend using the Firebase Admin SDK, which bypasses these rules. This is
// deliberate and matches the project design: clients (web AND mobile) never
// touch the database directly — they call our backend API, which is the single
// cross-platform gateway. (Checkoff 1 feedback: "cross-platform backend API
// call, not database".)
//
// To apply: Firebase console → Firestore Database → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
