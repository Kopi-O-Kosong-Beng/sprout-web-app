{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "node dist/server.js",
    "start:ts": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "migrate": "tsx database/migrate.ts",
    "migrate:rollback": "tsx database/rollback.ts",
    "seed": "tsx database/seed.ts",
    "seed:firestore": "tsx database/seed-firestore.ts",
    "seed:firebase-auth-demo": "tsx database/seed-firebase-auth-demo.ts",
    "backfill:user-audit-fields": "tsx scripts/backfill-user-login-audit-fields.ts",
    "reconcile:firestore": "tsx scripts/reconcile-sqlite-to-firestore.ts",
    "check:email": "tsx scripts/check-email.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "inspect": "tsx scripts/inspect-db.ts",
    "test": "tsx scripts/run-firestore-emulator-tests.ts",
    "test:jest": "jest --runInBand"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^10.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^2.0.1",
    "nodemailer": "^9.0.3",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "fast-check": "^3.23.2",
    "firebase-tools": "^14.27.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.ts"
    ],
    "testMatch": [
      "**/tests/**/*.test.ts"
    ]
  }
}
