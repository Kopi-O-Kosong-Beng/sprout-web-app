# Anything derived from a real .env — backups, per-host copies, scratch edits.
# The bare `.env` rule above does not cover `.env.bak`, `.env.prod` or
# `server/.env.bak.1234`, and a secrets file only has to be committable once.
.env.*
!.env.example


# Dashboard-import env files with real secrets (deploy/README.md is tracked)
deploy/*.env

# Isolated implementation worktrees
.worktrees/

# Local agent execution ledger and review artifacts
.superpowers/

# Knowledge-graph tool output: a derived cache, rebuilt on demand. Committing it
# put 201 files and 136k lines into one review.
.graphify/

# Playwright: browsers, traces, videos and HTML reports are all regenerated
# by a run. The traces alone are megabytes per failure.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Local output from scripts/backdrop-experiment.ts — renders, not source.
server/backdrop-experiment-out/

# Scratch landing area for source documents pulled off the shared drive — decks,
# pitch PDFs, exports. Anything from here that belongs in the repo gets moved to
# docs/final-submission/ rather than committed in place.
raw_damp/

# Individual reports are personal submissions, not team deliverables. They are
# graded per member and are nobody else's business, so they never enter this
# shared repository — not even under docs/final-submission/, which is otherwise
# where submitted artefacts live. Keep them local.
individual-report*
**/individual-report*
