# Copy to .env.local for local dev. On Vercel, set VITE_API_URL as a Project
# Environment Variable instead (Settings -> Environment Variables).

# Where the Express backend is reachable. Locally this is the server started
# by `npm run dev` from sprout-app/ (server/app.ts, default port 3001).
# If you deploy the frontend to Vercel but run the backend on your own
# machine, use a tunnel (e.g. ngrok) and put that public URL here instead.
VITE_API_URL=http://localhost:3001

# Firebase web app config. These values are safe for frontend code; they are
# NOT the backend service account. Copy them from Firebase Console -> Project
# settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Named Firestore database for the studio's dex and user_profiles reads.
# Optional: leave blank unless the project uses a non-default database, and
# the studio falls back to "(default)" — which is the database the rest of
# Sprout already uses.
VITE_FIREBASE_DATABASE_ID=

# Show the authenticated per-user demo plant switch.
VITE_ENABLE_DEMO_TOOLS=false
