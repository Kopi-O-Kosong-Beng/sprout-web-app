# Copy to server/.env and fill in. Never commit server/.env.

# Firestore is the only application datastore. Outside emulator tests, configure
# exactly one Firebase Admin credential method below.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Production hosts should prefer one of these secret env vars instead of a file.
# Paste the full service account JSON, or base64-encode the JSON file contents.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Browser origin that hosts the verification action page. Falls back to CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173

# Auth uses Firebase Auth ID tokens. The frontend signs in with the Firebase
# JS SDK and the backend verifies Authorization: Bearer <idToken>.

# Email — covers UC1 (verification link), UC3 (reset OTP), and UC8 (ticket
# confirmation to the submitter + notification to ADMIN_EMAIL). Three modes:
#   console — logs instead of sending (dev/tests); no account needed.
#   smtp    — Nodemailer. For Gmail, SMTP_PASS is a Google App Password
#             (myaccount.google.com/apppasswords, spaces removed), NEVER the
#             normal account password. Never commit it.
#   resend  — Resend HTTPS API. Use this on hosts that block outbound SMTP:
#             Render's free tier hangs on port 587 until the request times out,
#             which stalls signup for ~2 minutes and delivers nothing. Port 443
#             is open, so the API works where SMTP cannot.
EMAIL_MODE=console
EMAIL_FROM=hello.sprout.team@gmail.com
ADMIN_EMAIL=hello.sprout.team@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello.sprout.team@gmail.com
SMTP_PASS=
# Required when EMAIL_MODE=resend. Create at resend.com/api-keys.
RESEND_API_KEY=
# Verified sender. Until a custom domain is verified in Resend, the shared
# onboarding@resend.dev sender is the only address allowed (it can only mail
# the account owner's own address). Falls back to EMAIL_FROM, then that sender.
RESEND_FROM=
BCRYPT_COST=12

# External APIs (Req 11.5: keys live here only, never in code or client)
#
# USE_MOCK_APIS=true withholds every key below from the pipeline, so no upstream
# service is called and a scan costs nothing: identification returns a fixed
# species, the sprite is the procedural placeholder, and the run finishes in
# under a second instead of ~13. Leave it true for ordinary development — the
# keys are funded, and each real run bills five services. Set it false only when
# you actually need real art, and set it false on any deploy that serves players.
USE_MOCK_APIS=true
PLANTID_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
REMOVE_BG_API_KEY=
MIN_CONFIDENCE_THRESHOLD=0.70

# --- AI sprite pipeline (migrated from Sprout_Dev_Platform) ------------------
# Powers POST /api/pipeline/* (the Scan screen) and the studio at /studio.
#
# The three keys above are reused: the pipeline reads PLANTID_API_KEY,
# GEMINI_API_KEY and REMOVE_BG_API_KEY, and also accepts the names the platform
# used (PLANT_API_KEY, GEMINI_KEY, WITHOUTBG_KEY). Set either spelling, not both.
#
# NVIDIA credentials are new. One NVIDIA_API_KEY covers both models; set the
# per-model names only if the two use different credentials.
NVIDIA_API_KEY=
GEMMA_API_KEY=
FLUX_API_KEY=
# Which service renders the sprite first; the other is the automatic fallback.
IMAGE_PROVIDER=flux
# Overridable so a retired model is a config change, not a code change.
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
NVIDIA_VISION_MODEL=google/gemma-4-31b-it
GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite

# Every key above is optional: the pipeline degrades hop by hop rather than
# failing. With none set it still returns a sprite — a procedural placeholder —
# and the studio's Keys & Secrets page reports exactly which hops are live.
#
# The studio at /studio and /api/platform/* are gated by ADMIN_EMAILS below,
# on top of a verified Firebase login.

# STORAGE_MODE is a leftover: no code reads it any more. Sprites always go to
# Firebase Storage via server/services/sprite-storage.ts.
STORAGE_MODE=local
# Required. Scan-to-archive (UC6 -> UC4) throws without it, so every scan fails.
# Bucket live and preflighted since 2026-07-21; see server/FIREBASE_SETUP.md.
FIREBASE_STORAGE_BUCKET=sprout-dev-66f08.firebasestorage.app

# Dev-only fallback: allows `x-dev-uid: <userId>` header to stand in for a
# Firebase login on protected routes. Ignored in production.
AUTH_DEV_BYPASS=true

# Temporary deployed-demo bypass: allows `x-dev-uid` only when it matches this
# seeded demo user. Keep false outside short demos.
DEMO_AUTH_BYPASS=false
DEMO_AUTH_BYPASS_USER_ID=demo-user-0001

# Enables the authenticated archive demo-set endpoints during local demos only.
ENABLE_DEMO_TOOLS=false

# Admin account dashboard (/admin): comma-separated emails allowed to list and
# delete Sprout accounts. A caller still needs a valid verified Firebase token;
# this is an additional gate on top. Unset or empty denies everyone (fail
# closed), so a misconfigured deploy cannot expose account deletion.
#
# This list is also what /api/auth/me reports as isAdmin, which is how the
# frontend knows to send this account to /admin after login and to show the
# Admin nav link. Adding an address here is the whole of granting admin — there
# is no per-user flag in Firestore to migrate.
#
# Locally you may also add test@sprout.com. With AUTH_DEV_BYPASS=true and a dev
# build of the client, signing in as that address with ANY password takes the
# no-Firebase shortcut in client/src/services/devSession.ts and lands you in as
# an admin. It is inert anywhere else: the client half is behind
# import.meta.env.DEV and compiles out of `vite build`, and the server half
# additionally requires NODE_ENV !== 'production'. Do NOT add it on a deploy.
ADMIN_EMAILS=hello.sprout.team@gmail.com

# Credentials for `npm run seed:admin -w server`, which creates (or repairs) an
# admin login. Kept in .env rather than in the script so the password is not
# committed. The address must also appear in ADMIN_EMAILS above — the seed
# creates an account, the allowlist is what makes it an admin.
# Can be passed as arguments instead:
#   npm run seed:admin -w server -- sprout@gmail.com 'the-password'
SEED_ADMIN_EMAIL=sprout@gmail.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_DISPLAY_NAME=Sprout Admin
