# Copy to server/.env and fill in. Never commit server/.env.

# Firestore is the only application datastore. Outside emulator tests, configure
# exactly one Firebase Admin credential method below.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Production hosts should prefer one of these secret env vars instead of a file.
# Paste the full service account JSON, or base64-encode the JSON file contents.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
# Browser origin that hosts the verification action page. Falls back to CORS_ORIGIN.
FRONTEND_URL=http://localhost:5173

# Auth uses Firebase Auth ID tokens. The frontend signs in with the Firebase
# JS SDK and the backend verifies Authorization: Bearer <idToken>.

# Email — "console" logs emails instead of sending (dev/tests), "smtp" delivers
# via Nodemailer. Covers UC1 (verification link), UC3 (reset OTP), and UC8
# (ticket confirmation to the submitter + notification to ADMIN_EMAIL).
# For Gmail: SMTP_PASS is a Google App Password (myaccount.google.com/apppasswords,
# remove the spaces), NEVER the normal account password. Never commit it.
EMAIL_MODE=console
EMAIL_FROM=hello.sprout.team@gmail.com
ADMIN_EMAIL=hello.sprout.team@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello.sprout.team@gmail.com
SMTP_PASS=
BCRYPT_COST=12

# External APIs (Req 11.5: keys live here only, never in code or client)
USE_MOCK_APIS=true
PLANTID_API_KEY=
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
REMOVE_BG_API_KEY=
MIN_CONFIDENCE_THRESHOLD=0.70

# Keep local storage until Firebase Storage setup and bucket preflight pass.
# See server/FIREBASE_SETUP.md for the required manual activation sequence.
STORAGE_MODE=local
FIREBASE_STORAGE_BUCKET=

# Dev-only fallback: allows `x-dev-uid: <userId>` header to stand in for a
# Firebase login on protected routes. Ignored in production.
AUTH_DEV_BYPASS=true

# Temporary deployed-demo bypass: allows `x-dev-uid` only when it matches this
# seeded demo user. Keep false outside short demos.
DEMO_AUTH_BYPASS=false
DEMO_AUTH_BYPASS_USER_ID=demo-user-0001
