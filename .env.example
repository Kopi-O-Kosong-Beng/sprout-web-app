# Copy to server/.env and fill in. Never commit server/.env.

# Datastore: 'firestore' (final architecture, per Master.docx) or 'sqlite'
# (offline fallback + unit tests). See server/FIREBASE_SETUP.md.
DATASTORE=sqlite
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# SQLite fallback file (only used when DATASTORE=sqlite)
DB_FILENAME=./database/sprout.dev.sqlite3

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Auth (Req 11: JWT signed with env secret, 1h expiry)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY=1h

# Email — "console" logs emails instead of sending (dev), "smtp" uses the SMTP_* vars
EMAIL_MODE=console
EMAIL_FROM=no-reply@sprout.local
ADMIN_EMAIL=team@sprout.local
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# External APIs (Req 11.5: keys live here only, never in code or client)
USE_MOCK_APIS=true
PLANTID_API_KEY=
GEMMA_API_KEY=
FLUX_API_KEY=
MIN_CONFIDENCE_THRESHOLD=0.70
