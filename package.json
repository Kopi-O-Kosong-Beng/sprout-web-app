{
  "name": "sprout-webapp",
  "version": "0.1.0",
  "private": true,
  "description": "Sprout — Web Platform & B2B Showcase for Nature-Based Gamification (50.003 ESC C3T2)",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "seed": "npm run seed:firestore -w server",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client"
  }
}
